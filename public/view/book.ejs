<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Book</title>
        <link rel="stylesheet" href="..//css/style.css"/>
    </head>
    <body>
        <h1>View Book</h1>
        <table class="'book-table">
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
            <tr>
                <td><%= book.title%></td>
                <td><%= book.author%></td>
            </tr>
        </table>
        <div class="link-center">
            <a href="/update/<%= book.id%>"></a>
            <a href="/delete/<%= book.id %>"></a>
            <a href="/">Back to List</a>
        </div>
    </body>
</html>